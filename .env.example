# ==============================================================================
# PromptCheck Environment Configuration Template
# ATENÇÃO: NUNCA commite arquivos .env reais contendo segredos ou chaves.
# ==============================================================================

# ------------------------------------------------------------------------------
# Control Plane (Fastify API)
# ------------------------------------------------------------------------------
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Conexão com PostgreSQL (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/promptcheck
DATABASE_TEST_URL=postgres://postgres:postgrespassword@localhost:5432/promptcheck_test

# Segredos de Autenticação (devem ter alta entropia em produção)
JWT_SECRET=development-jwt-secret-min-32-chars-long-random-string
COOKIE_SECRET=development-cookie-secret-min-32-chars-long-random-string

# Políticas de CORS (em prod: *.techtinker.com.br)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Dashboard Web (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3333

# ------------------------------------------------------------------------------
# Execution Plane (CLI - Test Runner Local)
# ------------------------------------------------------------------------------
# Token do projeto obtido no Dashboard do PromptCheck
PROMPTCHECK_TOKEN=pck_live_sampletoken1234567890abcdefghijklmnopqrstuvwxyz

# Chave de API do provedor de LLM (OpenAI)
OPENAI_API_KEY=sk-mock-sample-key-for-local-testing

# URL da API do SaaS (opcional em dev; padrão é produção HTTPS)
PROMPTCHECK_API_URL=http://localhost:3333
