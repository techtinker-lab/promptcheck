{
  "name": "promptcheck-monorepo",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build && pnpm --recursive --filter \"./apps/*\" run build",
    "dev": "pnpm --parallel --filter @promptcheck/api --filter @promptcheck/web dev",
    "dev:api": "pnpm --filter @promptcheck/api dev",
    "dev:web": "pnpm --filter @promptcheck/web dev",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
